
:root {
  --blue: #3b5bdb;
  --blue-soft: #dbe4ff;
  --ink: #1f2430;
  --muted: #5b6270;
  --line: #d5d9e2;
  --card: #ffffff;
  --page: #eef1f8;
}

body {
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--ink);
  background: var(--page);
  line-height: 1.5;
}

form {
  max-width: 560px;
  margin: 2rem auto;
  padding: 0 1rem;
}

/* 1. Groups are cards... */
fieldset {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 1.25rem 1.25rem 1rem;
  margin: 0 0 1.25rem;
  box-shadow: 0 1px 3px rgba(31, 36, 48, 0.08);
}

/* 2. Titles are dark pills */
legend {
  background: var(--ink);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.25rem 0.9rem;
  border-radius: 999px;
}


fieldset fieldset {
  background: none;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  padding: 0;
  margin: 1rem 0 0;
}

fieldset fieldset legend {
  background: none;
  color: var(--ink);
  font-size: 0.9rem;
  font-weight: 600;
  padding: 0;
  border-radius: 0;
}

label {
  display: block;
  font-size: 0.85rem;
  color: var(--muted);
  margin-top: 0.75rem;
}

input[type="text"],
input[type="email"],
input[type="number"],
input[type="date"],
input[type="tel"],
select,
textarea {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: 0.25rem;
  padding: 0.5rem 0.65rem;
  font: inherit;
  color: var(--ink);
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 6px;
  transition: border-color 0.15s, box-shadow 0.15s;
}

/* 3. Required = blue line on the left */
input:required:not([type="radio"]):not([type="checkbox"]),
select:required,
textarea:required {
  border-left: 4px solid var(--blue);
}

/* 4. States */
input:hover:not([type="radio"]):not([type="checkbox"]),
select:hover,
textarea:hover {
  border-color: var(--blue);
}

input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: var(--blue);
  box-shadow: 0 0 0 3px var(--blue-soft);
}

input[type="radio"],
input[type="checkbox"] {
  accent-color: var(--blue);
}

input[type="radio"]:focus-visible,
input[type="checkbox"]:focus-visible,
input[type="range"]:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}

input[type="range"] {
  width: 100%;
  accent-color: var(--blue);
}

button,
input[type="submit"] {
  font: inherit;
  font-weight: 600;
  color: #fff;
  background: var(--blue);
  border: 0;
  border-radius: 8px;
  padding: 0.6rem 1.25rem;
  cursor: pointer;
  transition: background 0.15s;
}

button:hover,
input[type="submit"]:hover {
  background: #2f4ac0;
}

button:focus-visible,
input[type="submit"]:focus-visible {
  outline: 3px solid var(--blue-soft);
  outline-offset: 2px;
}